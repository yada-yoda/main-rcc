<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{% if isHome %}{{ site.section }} v{{ site.version }} &mdash; {{ site.domain }}{% else %}{{ title }} | {{ site.section }} v{{ site.version }} &mdash; {{ site.domain }}{% endif %}</title>
<meta name="description" content="{{ description or site.description }}">
<meta name="app-version" content="{{ site.version }}">
{% if noindex %}<meta name="robots" content="noindex, follow">{% endif %}
<link rel="canonical" href="{{ page.url | absUrl }}">
<meta name="theme-color" content="{{ site.themeColor }}">

{#- Favicon: a broadsheet column - navy page, cyan rule, ruled lines. Inline
    so the page costs no extra request, same approach as the rest of the fleet. -#}
<link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'><rect width='32' height='32' rx='4' fill='%232c2e3d'/><rect x='7' y='7' width='18' height='3' fill='%2300bcd4'/><rect x='7' y='14' width='18' height='2' fill='%23f5f1e8'/><rect x='7' y='19' width='18' height='2' fill='%23f5f1e8'/><rect x='7' y='24' width='11' height='2' fill='%23f5f1e8'/></svg>">
<link rel="apple-touch-icon" sizes="180x180" href="{{ '/apple-touch-icon.png' | href }}">
<meta name="apple-mobile-web-app-title" content="{{ site.domain }} {{ site.section }}">

<meta property="og:type" content="{{ ogType or 'website' }}">
<meta property="og:site_name" content="{{ site.domain }}">
<meta property="og:title" content="{% if isHome %}{{ site.section }} &mdash; {{ site.domain }}{% else %}{{ title }}{% endif %}">
<meta property="og:description" content="{{ description or site.description }}">
<meta property="og:url" content="{{ page.url | absUrl }}">
<meta property="og:image" content="{{ '/og.png' | absUrl }}">
<meta property="og:image:secure_url" content="{{ '/og.png' | absUrl }}">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta property="og:image:alt" content="{{ site.domain }} {{ site.section }} &mdash; {{ site.headline }}">
<meta property="og:locale" content="{{ site.locale }}">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{% if isHome %}{{ site.section }} &mdash; {{ site.domain }}{% else %}{{ title }}{% endif %}">
<meta name="twitter:description" content="{{ description or site.description }}">
<meta name="twitter:image" content="{{ '/og.png' | absUrl }}">

<link rel="alternate" type="application/rss+xml" title="{{ site.domain }} {{ site.section }}" href="{{ '/feed.xml' | href }}">
<link rel="stylesheet" href="{{ '/css/style.css' | href }}">

{#- Analytics: the rizzo.cc property, same as the acting pages. Adding
    ?ga=off to any URL once on a device stops counting that device for
    good; ?ga=on puts it back. -#}
<script>
(function(){
  try{
    var q=new URLSearchParams(location.search).get('ga');
    if(q==='off')localStorage.setItem('ga_optout','1');
    if(q==='on')localStorage.removeItem('ga_optout');
    if(localStorage.getItem('ga_optout')==='1')return;
  }catch(e){}
  var s=document.createElement('script');s.async=true;
  s.src='https://www.googletagmanager.com/gtag/js?id={{ site.ga4 }}';document.head.appendChild(s);
  window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments);}
  window.gtag=gtag;gtag('js',new Date());gtag('config','{{ site.ga4 }}',{anonymize_ip:true});
})();
</script>
</head>
<body>
<a class="skip-link" href="#main">Skip to content</a>
<div id="toast" class="toast" role="status" aria-live="polite" hidden></div>

<header class="topbar">
  <a class="home" href="{{ site.baseUrl }}/" title="Back to {{ site.domain }}"><b>{{ site.domain }}</b></a>
  <span class="sep" aria-hidden="true">/</span>
  <a class="mark" href="{{ '/' | href }}" title="{{ site.section }} home">{{ site.section }}</a>
  <nav class="nav" aria-label="Section">
    <a href="{{ '/' | href }}" title="All posts, newest first">Posts</a>
    <a href="{{ '/tags/' | href }}" title="Browse posts by tag">Tags</a>
    <a href="{{ '/feed.xml' | href }}" title="Subscribe in a feed reader (RSS)">RSS</a>
  </nav>
  <span class="ver" title="Section version (semantic versioning)">v{{ site.version }}</span>
</header>

{% if isHome %}
<div class="hero">
  <p class="kicker">{{ site.kicker }}</p>
  <h1>{{ site.headline }}</h1>
  <p class="lede">{{ site.intro }}</p>
</div>
{% endif %}

<main id="main" class="body{% if not showSide %} solo{% endif %}">
{{ content | safe }}
</main>

<footer class="footer">
  <span>{{ site.section }}</span>
  <span>Part of {{ site.domain }}</span>
  <span title="Section version (semantic versioning)">v{{ site.version }}</span>
</footer>

<script>
// Copy-link buttons. Passive confirmation only, so a top-center toast is
// the right feedback - nothing here asks the reader to decide anything.
(function(){
  var toast=document.getElementById('toast'),timer=null,show=null;
  function say(msg){
    if(!toast)return;
    toast.textContent=msg;toast.hidden=false;
    // A short timeout rather than requestAnimationFrame: rAF does not run in
    // a background tab, which would leave the toast in the DOM at opacity 0.
    clearTimeout(show);
    show=setTimeout(function(){toast.classList.add('on');},20);
    clearTimeout(timer);
    timer=setTimeout(function(){
      toast.classList.remove('on');
      setTimeout(function(){toast.hidden=true;},200);
    },1800);
  }
  document.addEventListener('click',function(e){
    var btn=e.target.closest('[data-copy]');
    if(!btn)return;
    e.preventDefault();
    var url=btn.getAttribute('data-copy')||location.href;
    if(navigator.clipboard&&navigator.clipboard.writeText){
      navigator.clipboard.writeText(url).then(function(){say('Link copied');},function(){say('Could not copy');});
    }else{
      say('Could not copy');
    }
  });
})();
</script>
</body>
</html>
